# ---- Logs & reports produced by WinCleanKit at runtime ----
WinCleanKit-*.log
*.log
logs/
reports/
WinCleanKitRestore_*/
TelemetryOff_*/

# ---- Release packages built by tools/New-ReleasePackage.ps1 ----
dist/

# ---- PowerShell ----
# Module manifests are generated by tooling and are not source. The analyzer
# settings file IS source, so it is explicitly re-included: a bare *.psd1 here
# silently excluded .github/PSScriptAnalyzerSettings.psd1 from the repository,
# which made the lint gate fall back to defaults in CI.
*.psd1
!.github/PSScriptAnalyzerSettings.psd1
*.psm1.bak
*.ps1.bak

# ---- Windows / editor cruft ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---- Editors / IDEs ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~

# ---- OS / misc ----
.DS_Store
*.tmp
*.temp
